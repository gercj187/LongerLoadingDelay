<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>LongerLoadingDelay</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>

		<!-- Spielpfad zentral; bei Bedarf per Directory.Build.props / Kommandozeile überschreiben -->
		<DvManaged Condition="'$(DvManaged)' == ''">S:\SteamLibrary\steamapps\common\Derail Valley\DerailValley_Data\Managed</DvManaged>
	</PropertyGroup>

	<!-- Derail Valley (Private=false: Spiel-DLLs nicht in den Build kopieren) -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp"><HintPath>$(DvManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.ThingTypes"><HintPath>$(DvManaged)\DV.ThingTypes.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Utils"><HintPath>$(DvManaged)\DV.Utils.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Common"><HintPath>$(DvManaged)\DV.Common.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Localization"><HintPath>$(DvManaged)\DV.Localization.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Inventory"><HintPath>$(DvManaged)\DV.Inventory.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Newtonsoft.Json"><HintPath>$(DvManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="WorldStreamer"><HintPath>$(DvManaged)\WorldStreamer.dll</HintPath><Private>false</Private></Reference>
	</ItemGroup>

	<!-- Unity -->
	<ItemGroup>
		<Reference Include="UnityEngine"><HintPath>$(DvManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><HintPath>$(DvManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.IMGUIModule"><HintPath>$(DvManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.AudioModule"><HintPath>$(DvManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(DvManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.PhysicsModule"><HintPath>$(DvManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.UI"><HintPath>$(DvManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.UIModule"><HintPath>$(DvManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Unity.TextMeshPro"><HintPath>$(DvManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
	</ItemGroup>

	<!-- Mod Loader -->
	<ItemGroup>
		<PackageReference Include="UnityModManager" Version="0.27.2" />
	</ItemGroup>

	<!-- Null Checking -->
	<ItemGroup>
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
	</ItemGroup>

	<!-- Multiplayer-Anbindung zuerst bauen (landet ebenfalls in ../build/); KEIN Assembly-Verweis -->
	<ItemGroup>
		<ProjectReference Include="..\LongerLoadingDelay.Multiplayer\LongerLoadingDelay.Multiplayer.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy to build folder -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="../build/" />

		<!-- Package after Release build -->
		<Exec Condition="'$(ConfigurationName)' == 'Release' And '$(OS)' == 'Windows_NT'" Command="powershell -executionpolicy bypass -Command &quot;(../package.ps1)&quot;" />
		<Exec Condition="'$(ConfigurationName)' == 'Release' And '$(OS)' != 'Windows_NT'" Command="pwsh -Command &quot;(../package.ps1)&quot;" />
	</Target>
</Project>
